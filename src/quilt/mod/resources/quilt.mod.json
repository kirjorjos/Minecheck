{
  "schema_version": 1,
  "quilt_loader": {
    "group": "net.minecheck",
    "id": "minecheck",
    "version": "${version}",
    "metadata": {
      "name": "Minecheck",
      "description": "Scripted automation of the Minecraft client and server for mod development",
      "license": "${licence}",
      "contributors": {
        "Minecheck": []
      }
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "jars": [
      "${qsl_base_jar}"
    ],
    "mixin": [
      "minecheck.mixins.json"
    ],
    "entrypoints": {
      "init": [
        "net.minecheck.loader.quilt.QuiltEntrypoint"
      ]
    },
    "depends": [
      { "id": "quilt_loader", "versions": ">=0.19.0" },
      { "id": "fabric-api", "versions": ">=0.116.18" },
      { "id": "minecraft", "versions": ">=${minecraft_version}" }
    ]
  }
}
