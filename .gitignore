# Ignore all dot files by default...
.*
# Include specific ones
!.gitignore
!.gitattributes
!.editorconfig
!.github/

# ---- Gradle ----
.gradle/
**/build/
gradle-app.setting
.gradletasknamecache
local.properties
run/

# Stray MC logs at the repo root (from manual dev runs)
logs/

# ---- MC runtime dirs (generated by unimined run tasks) ----
src/fabric/mod/run/
src/forge/mod/run/
src/quilt/mod/run/

# ---- Java ----
*.class
**/bin/

# ---- IDE ----
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
# Eclipse
.project
.classpath
.settings/
.factorypath
# VS Code
.vscode/
