{
  "loaders": [
    "forge",
    "legacyfabric"
  ],
  "release": {
    "prefix": "MineCheck-",
    "nameFormat": "{loader}-{mc}-{version}{deobf}.jar",
    "variants": [
      "",
      "-deobf"
    ],
    "artifactsDir": "build/artifacts"
  },
  "setup": [
    "sudo apt-get update",
    "sudo apt-get install -y libgl1-mesa-dri libglx-mesa0 libgl1 mesa-utils x11-xserver-utils"
  ]
}
